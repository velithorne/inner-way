{
  "expo": {
    "name": "DECODE",
    "slug": "decode",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.velithorne.decode",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "DECODE needs the camera to show the physical world with sensor overlays.",
          "microphonePermission": "DECODE needs the microphone to map room geometry from sound."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DECODE uses your position to re-run acoustic measurement after you move a significant distance."
        }
      ]
    ]
  }
}
