{
  "expo": {
    "name": "Spectra",
    "slug": "spectra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spectra.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Spectra needs your location to map WiFi signals and upload crowd data.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Spectra uses location for WiFi scanning and mapping.",
        "NSMotionUsageDescription": "Spectra uses the magnetometer for compass orientation."
      }
    },
    "android": {
      "package": "com.spectra.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "NEARBY_WIFI_DEVICES"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "@react-native-firebase/app",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Spectra to use your location for WiFi scanning and mapping."
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": ""
        }
      ]
    ]
  }
}
