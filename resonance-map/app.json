{
  "expo": {
    "name": "The Resonance Map",
    "slug": "resonance-map",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00000A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.resonancemap.app",
      "config": {
        "googleMapsApiKey": "AIzaSyAa3F6MTRskKspbBTtMgDYNRWoQ8PRgbRE"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Location is used to show your position on the field map and record GPS coordinates when anomalies are detected.",
        "NSMotionUsageDescription": "Motion sensor data is used for magnetometer readings and field visualization.",
        "NSCameraUsageDescription": "The camera is used as a live viewfinder for AR electromagnetic field overlay."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00000A"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.resonancemap.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAa3F6MTRskKspbBTtMgDYNRWoQ8PRgbRE"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Location is used to show your position on the field map and record GPS coordinates when anomalies are detected."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "The camera is used as a live viewfinder for AR electromagnetic field overlay.",
          "enableMicrophonePermission": false
        }
      ],
      "react-native-wifi-reborn"
    ]
  }
}
