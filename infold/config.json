{
  "project": {
    "id": null,
    "source_path": ".",
    "exclude_patterns": [".git", "__pycache__", "*.pyc", ".venv", "venv", "node_modules", ".tox", "dist", "build"],
    "include_extensions": [".py", ".js", ".ts", ".json", ".yaml", ".yml", ".md", ".txt"]
  },
  "parser": {
    "strict_mode": false,
    "confidence_threshold": 0.7,
    "python": {"enabled": true},
    "javascript": {"enabled": true},
    "typescript": {"enabled": true},
    "json": {"enabled": true},
    "yaml": {"enabled": true},
    "markdown": {"enabled": true},
    "text": {"enabled": true}
  },
  "operators": {
    "exact_repetition": {"enabled": true},
    "template_skeleton": {"enabled": true},
    "symbol_table": {"enabled": true},
    "hierarchy_mirror": {"enabled": true},
    "dependency_motif": {"enabled": true}
  },
  "thresholds": {
    "exact_repetition": {
      "min_region_length_bytes": 64,
      "min_occurrences": 2,
      "max_overlap_tolerance": 0
    },
    "template_skeleton": {
      "min_family_size": 3,
      "min_scaffold_similarity": 0.80,
      "max_slot_ratio": 0.35
    },
    "symbol_table": {
      "min_symbol_reuse_count": 5,
      "min_bundle_reuse_count": 3
    },
    "hierarchy_mirror": {
      "min_subtree_depth": 2,
      "min_repeated_instances": 2,
      "min_structure_similarity": 0.85
    },
    "dependency_motif": {
      "min_motif_node_count": 3,
      "min_occurrences": 2,
      "reject_overlap_ambiguity": true
    }
  },
  "validation": {
    "min_net_gain": 0,
    "max_stress": 1.0,
    "min_utility_score": 0,
    "exact_mode": true
  },
  "benchmark": {
    "enabled": true,
    "baselines": ["raw", "zip", "gzip"]
  },
  "report": {
    "export_json": true,
    "export_text": true,
    "output_dir": "infold_reports"
  }
}
