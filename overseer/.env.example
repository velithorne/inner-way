# OVERSEER local development environment - FAKE / LOCAL VALUES ONLY.
# Copy to `.env` (git-ignored) for local use:  cp .env.example .env
# Never put production credentials, real API tokens or real customer data in this file or in
# a local `.env`. The values below are throwaway defaults for the docker-compose services.

# --- Runtime --------------------------------------------------------------
# local | staging | production. `local` makes the API refuse non-local service hosts.
OVERSEER_ENV=local
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=4000
HEALTH_CHECK_TIMEOUT_MS=2000

# --- PostgreSQL (docker-compose service `postgres`) ------------------------
POSTGRES_USER=overseer
POSTGRES_PASSWORD=overseer_local_only
POSTGRES_DB=overseer
POSTGRES_PORT=5432
DATABASE_URL=postgres://overseer:overseer_local_only@127.0.0.1:5432/overseer

# --- Redis (docker-compose service `redis`) --------------------------------
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# --- S3-compatible object storage (docker-compose service `objectstore`) ---
# Adobe S3Mock locally: it creates S3_BUCKET at start-up and does not validate credentials.
# The values below are still required because the S3 client signs every request.
S3_PORT=9000
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=overseer-local
S3_ACCESS_KEY_ID=overseer_local_only
S3_SECRET_ACCESS_KEY=overseer_local_only_secret
S3_FORCE_PATH_STYLE=true
